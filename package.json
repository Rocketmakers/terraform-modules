{
  "name": "terraform-modules",
  "version": "3.6.0",
  "description": "Terraform modules for use in Rocketmakers projects",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@rocketmakers/log": "^0.1.0",
    "@rocketmakers/shell-commands": "8.1.0",
    "@types/bunyan": "^1.8.8",
    "@types/node": "20.17.6",
    "@types/underscore": "^1.10.23",
    "commitizen": "^4.2.4",
    "cz-customizable": "^6.3.0",
    "handlebars": "^4.7.7",
    "husky": "^4.3.8",
    "standard-version": "^9.3.0",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.5",
    "underscore": "^1.13.1"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}
