{
  "name": "terraform-modules",
  "version": "0.0.1",
  "description": "Terraform modules for use in Rocketmakers projects",
  "private": true,
  "scripts": {
    "postinstall": "make setup-terraform",
    "postversion": "make changelog"
  },
  "license": "MIT",
  "devDependencies": {
    "@rocketmakers/shell-commands": "^1.7.0",
    "@types/node": "^14.11.2",
    "@types/underscore": "^1.10.23",
    "commitizen": "^4.2.4",
    "cz-customizable": "^6.3.0",
    "handlebars": "^4.7.7",
    "husky": "^4.3.8",
    "ts-node": "^9.0.0",
    "typescript": "^4.0.3",
    "standard-version": "^9.3.0",
    "underscore": "^1.13.1"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}
