{
  "name": "terraform-modules",
  "version": "4.0.0",
  "description": "Terraform modules for use in Rocketmakers projects",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rocketmakers/terraform-modules"
  },
  "scripts": {
    "az-login": "az login --tenant 09e95bcb-540c-433b-8597-3e94ab4119e5 && az account set --subscription 68bb123f-6027-4e99-8ab0-a01fb16cdd79",
    "format": "terraform fmt -recursive -check",
    "format-fix": "terraform fmt -recursive",
    "prepare": "if [ -z \"$CI\" ]; then husky; fi"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "devDependencies": {
    "commit-and-tag-version": "12.6.1",
    "commitizen": "^4.2.4",
    "cz-customizable": "^6.3.0",
    "husky": "9.1.7",
    "turbo": "2.7.0"
  },
  "packageManager": "pnpm@10.26.1"
}
